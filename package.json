{
  "name": "legalmene",
  "version": "0.1.0",
  "private": true,
  "description": "LegalChile PSL — Sistema de gestión legal SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "pnpm --filter @legalmene/shared build && pnpm --filter @legalmene/api dev",
    "api:build": "pnpm --filter @legalmene/shared build && pnpm --filter @legalmene/api build",
    "api:start": "pnpm --filter @legalmene/api start:prod",
    "shared:build": "pnpm --filter @legalmene/shared build",
    "shared:dev": "pnpm --filter @legalmene/shared dev",
    "web:dev": "pnpm --filter @legalmene/web dev",
    "web:build": "pnpm --filter @legalmene/web build",
    "db:generate": "pnpm --filter @legalmene/api db:generate",
    "db:migrate": "pnpm --filter @legalmene/api db:migrate",
    "db:seed": "pnpm --filter @legalmene/api db:seed",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
