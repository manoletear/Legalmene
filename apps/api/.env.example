# LegalChile PSL — API config

NODE_ENV=development
PORT=3001

# DEV ONLY — bypass JWT auth. Sin header se usa el admin demo; X-Dev-User=<base64 JSON
# {entraOid,email,nombre,perfil}> impersona un perfil por su código (ABOGADO, CONTADOR…).
# NUNCA habilitar en producción.
AUTH_DISABLED=true

# Dominios de correo autorizados para ingresar (coma). Se ignora con AUTH_DISABLED.
ALLOWED_EMAIL_DOMAIN=legalchile.cl

# PostgreSQL (local Docker o Aurora)
DATABASE_URL=postgresql://legalmene:legalmene@localhost:5432/legalmene

# Microsoft Entra ID (Azure AD)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_AUDIENCE=api://your-app-id
ENTRA_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
ENTRA_JWKS_URI=https://login.microsoftonline.com/your-tenant-id/discovery/v2.0/keys

# Login con enlace de acceso (magic link): firma de las sesiones propias (mínimo 32 caracteres).
# Sin él, en desarrollo se usa un secreto temporal; en producción es obligatorio.
SESSION_JWT_SECRET=
# El enlace llega por correo vía SES (SES_ENABLED=true). Con AUTH_DISABLED=true (demo) no se
# envía: el enlace se muestra en la pantalla de login.

# Correos (separados por coma) que al primer login con Entra ID o enlace de acceso entran como Administrador
# activo. El resto de los usuarios nuevos queda inactivo hasta que un administrador lo habilite.
BOOTSTRAP_ADMIN_EMAILS=

# CORS
WEB_ORIGIN=http://localhost:4200

# WebPay (Transbank integración)
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENV=integration

# Email (Amazon SES). SES_ENABLED=true para enviar de verdad (enlaces de acceso, avisos).
SES_ENABLED=false
SES_REGION=sa-east-1
SES_FROM=no-reply@legalchile.cl

# Storage de documentos: "s3" (default, requiere AWS creds) o "local" (dev sin AWS)
STORAGE_BACKEND=local

# S3 documentos (cuando STORAGE_BACKEND=s3)
AWS_REGION=sa-east-1
S3_DOCUMENTS_BUCKET=legalmene-dev-documents
# Opcional: para LocalStack/MinIO en dev
# S3_ENDPOINT=http://localhost:4566

# Local FS storage (cuando STORAGE_BACKEND=local)
DOCUMENTS_LOCAL_DIR=./data/docs
DOCUMENTS_LOCAL_SECRET=dev-only-secret-change-in-prod
API_PUBLIC_URL=http://localhost:3001

# Modo mantenimiento (lecturas pasan, mutaciones devuelven 503).
# Usar para ventanas de despliegue/migración.
# MAINTENANCE_MODE=true
# MAINTENANCE_RETRY_AFTER=300
